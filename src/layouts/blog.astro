---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link
			rel="preload"
			href="/fonts/SVN-Georgia.otf"
			as="font"
			type="font/otf"
			crossorigin
		/>
		<title>{title} - bien pensant</title>
	</head>

	<body>
		<header>
			<div class="header-logo">
				<kbd>λ</kbd> / <kbd>Ж</kbd> / <kbd>あ</kbd>
			</div>
			<img src="/favicon.png" width="25" alt="" />
		</header>

		<main>
			<section>
				<a href="/" style="text-decoration: none;">
					{title}
				</a>
				<div>{description}</div>
			</section>

			<div style="margin: 20px 0; border-bottom: 1px dashed;"></div>
			<slot />
		</main>
	</body>
</html>

<style>
	/* Font */
	@font-face {
		font-family: "Georgia VN";
		src: url("/fonts/SVN-Georgia.otf") format("opentype");
		font-style: normal;
		font-display: swap;
	}

	/* Body */
	:root {
		--background: #ffffff;
		--soft-background: #f6f8fa;
		--text-color: #000000;
		--subtext-color: #808080;
	}

	:global(::selection) {
		background: var(--text-color);
		color: var(--background);
	}

	body {
		margin: 0;
		padding: 50px 5%;
		color: var(--text-color);
		font-family: "Segoe UI", system-ui;
	}

	/* Header */
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	header div {
		color: var(--text-color);
		font-family: "Georgia VN", "Times New Roman", serif;
		font-size: 24px;
		text-decoration: none;
		min-height: 42px;
	}

	kbd {
		background: var(--text-color);
		color: var(--background);
		padding: 2px 2px;
		border-radius: 3px;
		font-size: 0.85em;
		font-weight: bold;
		line-height: 1;
		display: inline-block;
	}

	/* Main */
	main {
		max-width: 750px;
		margin: 50px auto;
		line-height: 1.7;
	}

	section {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0;
	}

	section a {
		font-family: "Georgia VN", "Times New Roman", serif;
		font-size: 15px;
		color: var(--text-color);
		text-wrap: balance;
	}

	section a:hover {
		color: var(--subtext-color);
	}

	section div {
		font-family: monospace;
		font-size: 13px;
		color: var(--subtext-color);
		text-wrap: balance;
	}

	/* Markdown */
	:global(p) {
		text-wrap: pretty;
	}

	:global(h1, h2, h3, h4, h5, h6) {
		position: relative;
		font-weight: normal;
		margin: 10px 0;
		text-wrap: balance;
	}

	:global(a) {
		color: var(--text-color);
	}

	:global(a:hover),
	:global(a:visited) {
		color: var(--subtext-color);
	}

	:global(img) {
		display: block;
		max-width: 100%;
	}

	:global(table) {
		border-collapse: collapse;
	}

	:global(th),
	:global(td) {
		border: 1px solid var(--subtext-color);
		padding: 0.5rem;
	}

	:global(th) {
		background: var(--soft-background);
		font-weight: normal;
	}

	:global(blockquote) {
		margin: 1em 0;
		text-align: left;
		padding: 1px 20px;
		background-color: var(--soft-background);
	}

	:global(abbr) {
		text-decoration-style: wavy;
		text-decoration-thickness: 0.5px;
		cursor: help;
	}

	:global(sup a) {
		text-decoration: none;
	}

	:global(sup a::before) {
		content: "[";
	}

	:global(sup a::after) {
		content: "]";
	}

	:global(details summary::before) {
		content: "⬘ ";
	}

	:global(details[open] summary::before) {
		content: "⬙ ";
	}

	:global(details) {
		display: inline;
		cursor: help;
	}

	:global(details summary) {
		display: inline;
	}

	:global(details img) {
		margin: 1em 0;
	}

	:global(section.footnotes) {
		margin-top: 20px;
		border-top: 1px dotted;
	}

	:global(#footnote-label) {
		display: none;
	}

	/* https://shiki.style/ */
	:global(pre.astro-code) {
		background-color: var(--soft-background) !important;
		padding: 15px;
		overflow-x: auto;
	}

	/* rehype-github-alerts */
	:global(.markdown-alert) {
		margin: 1em 0;
		padding: 0 1em;
		border-left: 4px solid var(--alert-color);
	}

	:global(.markdown-alert-title) {
		display: flex;
		align-items: center;
		gap: 0.5em;
		color: var(--alert-color);
		margin-bottom: -10px;
	}

	:global(.markdown-alert svg.octicon) {
		fill: var(--alert-color);
	}

	:global(.markdown-alert-note) {
		--alert-color: #58a6ff;
	}

	:global(.markdown-alert-tip) {
		--alert-color: #3fb950;
	}

	:global(.markdown-alert-important) {
		--alert-color: #d2a8ff;
	}

	:global(.markdown-alert-warning) {
		--alert-color: #d29922;
	}

	:global(.markdown-alert-caution) {
		--alert-color: #f85149;
	}

	/* rehype-link-favicons */
	:global(a img) {
		display: inline;
		margin: 0 0.25em 0 0;
		vertical-align: -0.1em;
		border-radius: 2px;
	}

	/* remark-youtube */
	:global(iframe) {
		display: block;
		width: 100%;
		max-width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
	}

	/* rehype-autolink-headings */
	:global(.heading-anchor) {
		position: absolute;
		left: -1em;
		top: 0.5em;

		color: var(--subtext-color);

		opacity: 0;
		transition:
			opacity 150ms ease,
			visibility 0s linear 150ms;
	}

	:global(.heading-anchor svg) {
		display: block;
		width: 0.8em;
		heighs: 0.8em;
	}

	:global(h1:hover .heading-anchor),
	:global(h2:hover .heading-anchor),
	:global(h3:hover .heading-anchor),
	:global(h4:hover .heading-anchor),
	:global(h5:hover .heading-anchor),
	:global(h6:hover .heading-anchor) {
		opacity: 1;
	}
</style>
