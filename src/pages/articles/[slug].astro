---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const articles = await getCollection("articles");

	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={article.data.description} />
		<title>{article.data.title} - bien pensant</title>
	</head>

	<body>
		<header>
			<a href="/" class="header-logo">bien pensant</a>
			<img src="/favicon.png" width="25" />
		</header>

		<main>
			<section>
				<div id="article-title">{article.data.title}</div>
				<div id="article-description">{article.data.description}</div>
			</section>
			<div style="margin: 20px 0; border-bottom: 1px dashed"></div>
			<Content />
		</main>
	</body>
</html>

<style>
	/* Body */
	:root {
		--background: #ffffff;
		--soft-background: #f6f8fa;
		--text-color: #000000;
		--subtext-color: #808080;
		--accent: AccentColor;
	}

	::selection {
		background: var(--text-color);
		color: var(--background);
	}

	body {
		margin: 0px;
		padding: 50px 5%;
		color: var(--text-color);
		font-family: "Segoe UI", system-ui;
	}

	/* Header */
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	header a {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 24px;
		text-decoration: none;
		min-height: 42px;
	}

	header a:hover {
		color: var(--subtext-color);
	}

	/* Main */
	main {
		max-width: 750px;
		margin: 50px auto;
		line-height: 1.65;
	}

	section {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0px;
	}

	#article-title {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 15px;
		color: var(--text-color);
	}

	#article-description {
		font-family: monospace;
		font-size: 13px;
		color: var(--subtext-color);
	}

	/* Markdown configuration */
	:global(::selection) {
		background: var(--text-color);
		color: var(--background);
	}

	:global(h1, h2, h3, h4, h5, h6) {
		font-weight: normal;
		margin: 10px 0;
	}

	:global(a) {
		color: var(--text-color);
	}

	:global(a):hover {
		color: var(--subtext-color);
	}

	:global(a):visited {
		color: var(--subtext-color);
	}

	:global(img) {
		display: block;
		max-width: 100%;
		/* margin: 1rem auto; */
	}

	:global(table) {
		border-collapse: collapse;
	}

	:global(th),
	:global(td) {
		border: 1px solid var(--subtext-color);
		padding: 0.5rem 0.5rem;
	}

	:global(th) {
		background: var(--soft-background);
		font-weight: normal;
	}

	:global(blockquote) {
		margin: 1em 0;
		text-align: left;
		padding: 1px 20px;
		background-color: var(--soft-background);
	}

	:global(pre.astro-code) {
		background-color: var(--soft-background) !important;
		border: 1px solid var(--soft-background);
		border-radius: 6px;
		padding: 16px;
		overflow-x: auto;
	}

	:global(.markdown-alert) {
		margin: 1em 0;
		padding: 0em 1em;
		border-left: 4px solid var(--alert-color);
	}

	:global(.markdown-alert-title) {
		display: flex;
		align-items: center;
		gap: 0.5em;
		color: var(--alert-color);
		margin-bottom: -10px;
	}

	:global(.markdown-alert svg.octicon) {
		fill: var(--alert-color);
	}

	:global(.markdown-alert-note) {
		--alert-color: #58a6ff;
	}

	:global(.markdown-alert-tip) {
		--alert-color: #3fb950;
	}

	:global(.markdown-alert-important) {
		--alert-color: #d2a8ff;
	}

	:global(.markdown-alert-warning) {
		--alert-color: #d29922;
	}

	:global(.markdown-alert-caution) {
		--alert-color: #f85149;
	}
</style>
