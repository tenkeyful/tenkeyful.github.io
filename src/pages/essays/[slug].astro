
---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const essays = await getCollection("essays");

  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={essay.data.description} />
    <title>{essay.data.title} — bien pensant</title>
  </head>

  <body>
    <header>
      <a href="/" class="header-logo">bien pensant</a>
    </header>

    <main>
      <article>
        <h1>{essay.data.title}</h1>
        <Content />
      </article>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    padding: 50px 5%;
    background: #fff;
    color: #000;
  }

  .header-logo {
    color: inherit;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    text-decoration: none;
  }

  article {
    max-width: 680px;
    margin: 70px auto;
    line-height: 1.8;
  }

  h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    line-height: 1.2;
  }

  article :global(p),
  article :global(blockquote) {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 17px;
  }
</style>