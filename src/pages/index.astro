---
import { getCollection } from "astro:content";

const articles = await getCollection("articles");
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="my cringey blog" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link
			rel="preload"
			href="/fonts/SVN-Georgia.otf"
			as="font"
			type="font/otf"
			crossorigin
		/>
		<title>bien pensant</title>
	</head>

	<body>
		<!-- Header -->
		<header>
			<div class="header-left">
				<span class="header-icon">🗀</span>

				<div class="header-category">
					{[
						...new Set(
							articles.map((essay) => essay.data.category).filter(Boolean),
						),
					].map((category) => (
						<label>
							<input type="checkbox" value={category} />
							{category}
						</label>
					))}
				</div>
			</div>
			<p>my cringey blog</p>
		</header>

		<!-- Main -->
		<main>
			<section class="articles">
				<ol>
					{articles.map((essay, i) => (
						<li data-category={essay.data.category}>
							<span class="ol-number">{String(i + 1).padStart(2, "0")}</span>
							<a href={`/articles/${essay.id}/`}>{essay.data.title}</a>
							<span>{essay.data.description}</span>
						</li>
					))}
				</ol>
			</section>
		</main>

		<!-- Footer -->
		<footer>
			<div class="footer-links">
				<a
					href="https://github.com/tenkeyful"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub"
				>
					<img
						src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg"
						alt=""
						class="contact"
					/>
				</a>

				<a
					href="mailto:contact@bienpensant.com"
					aria-label="Contact by email"
					style="color: var(--text-color); font-size: 24px; text-decoration: none"
				>
					@
					<span style="font-family: monospace; font-size: 10px; color: var(--subtext-color); margin-left: 0.35em;">
						I can only receive emails :(
					</span>
				</a>
			</div>

			<a href="/notes/why" style="color: var(--subtext-color);">
				<p>Why an old-school blog?</p>
			</a>
		</footer>
	</body>
</html>

<style>
	/* Font */
	@font-face {
		font-family: "Georgia VN";
		src: url("/fonts/SVN-Georgia.otf") format("opentype");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	/* Body */
	:root {
		--background: #ffffff;
		--text-color: #000000;
		--subtext-color: #808080;
	}

	::selection {
		background: var(--text-color);
		color: var(--background);
	}

	body {
		margin: 0;
		padding: 50px 5%;
		background: radial-gradient(
			circle,
			color-mix(in srgb, var(--background), var(--text-color) 5%),
			color-mix(in srgb, var(--background), var(--text-color) 1%),
			var(--background) 100%
		);
	}

	/* Subtext */
	p {
		font-family: monospace;
		font-size: 13px;
		color: var(--subtext-color);
	}

	/* Header */
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--text-color);
		cursor: help;
	}

	/* Header -> Category */
	.header-left:hover .header-category {
		display: flex;
	}

	.header-category {
		display: none;
		gap: 10px;
		padding: 10px 10px;
		border: 1px dashed var(--subtext-color);
	}

	.header-category label {
		display: flex;
		align-items: center;
		gap: 5px;
		font-family: monospace;
		font-size: 13px;
		cursor: pointer;
	}

	.header-category input[type="checkbox"] {
		accent-color: var(--text-color);
	}

	.header-icon {
		display: inline-block;
	}

	.header-icon {
		font-size: 0;
	}

	.header-icon::before {
		content: "🗀";
		font-size: 24px;
	}

	.header-left:hover .header-icon::before {
		content: "🗁";
	}

	li[hidden] {
		display: none;
	}

	/* Articles */
	ol {
		padding: 0;
		list-style: none;
	}

	.ol-number {
		font-family: monospace;
		letter-spacing: 1px;
	}

	li {
		display: flex;
		align-items: center;
		gap: 15px;
		padding: 20px 0;
		border-bottom: 1px dashed var(--subtext-color);
		color: var(--subtext-color);
	}

	li a {
		flex: 1;
		font-family: "Georgia VN", serif;
		font-synthesis: none;
		font-size: 15px;
		color: var(--text-color);
		text-decoration: none;
		text-wrap: balance;
	}

	li a:hover {
		color: var(--subtext-color);
	}

	li span {
		margin-left: auto;
		font-family: monospace;
		font-size: 13px;
		color: var(--subtext-color);
		text-align: right;
		text-wrap: balance;
	}

	/* Footer */
	footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 25px;
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.footer-links a:hover {
		opacity: 0.5;
	}

	.contact {
		display: block;
		width: 25px;
		height: 25px;
	}
</style>

<script>
	const filters = document.querySelectorAll<HTMLInputElement>(
		".header-category input",
	);
	const articles = document.querySelectorAll<HTMLLIElement>(".articles li");

	filters.forEach((filter) => {
		filter.addEventListener("change", () => {
			const selected = Array.from(filters)
				.filter((input) => input.checked)
				.map((input) => input.value);

			articles.forEach((article) => {
				const category = article.dataset.category ?? "";

				article.hidden = selected.length > 0 && !selected.includes(category);
			});
		});
	});
</script>
